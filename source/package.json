{
  "name": "willa-checkin",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalne przygotowanie dokumentów meldunkowych dla recepcji",
  "main": "app/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:fixtures": "node scripts/check-fixtures.mjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "pdfjs-dist": "5.6.205"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "pl.willaodkrywcow.checkin",
    "productName": "Willa Check-in",
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "files": [
      "app/**/*",
      "src/**/*",
      "templates/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Willa-Checkin-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
